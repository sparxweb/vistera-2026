# ==============================================================================
# FOODFLOW: Environment Variables Configuration Template
# Problem: VISTERA 2026 PS-44 — Cutting Food Waste
# ==============================================================================

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-server-routes-only

# AI Providers (Executed strictly server-side in /api/ai and /api/forecast)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
NVIDIA_API_KEY=your-nvidia-nim-api-key

# Mapbox GL JS Public Access Token (for Recovery Corridor Map in Hyderabad)
# Sign up at https://mapbox.com for a free public token (pk.xxx...)
# If unset or invalid, FoodFlow gracefully falls back to an interactive GIS card corridor.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-public-mapbox-access-token
